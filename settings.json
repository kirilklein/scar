{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(black *)",
      "Bash(flake8 *)",
      "Bash(pytest *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(pwd*)",
      "Bash(cd *)",
      "Bash(source *)",
      "Bash(. *)",
      "Bash(export *)",
      "Bash(uv *)",
      "Bash(coverage *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(set *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-protected-push.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dangerous-commands.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "alwaysThinkingEnabled": true
}
